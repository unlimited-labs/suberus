DATABASE_URL="postgresql://suberus:suberus_dev_password@localhost:5432/suberus?schema=public"

# S3-compatible object storage (Garage/MinIO/AWS S3/...)
# GARAGE_* names still work as deprecated aliases.
S3_ENDPOINT="http://localhost:3902"
S3_ACCESS_KEY_ID="your_access_key"
S3_SECRET_ACCESS_KEY="your_secret_key"
S3_BUCKET="suberus-files"

# Email (Mailpit for development)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@suberus.local"
MAILPIT_URL="http://localhost:8025"
# Pause between each email in a bulk campaign (seconds, default 5).
BULK_EMAIL_DELAY_SECONDS="5"

# Hard upload-size cap (MB) for files not bound to a submission type:
# review attachments and extraction-for-autofill. Per-type submission limits
# are configured per submission type in the admin panel (default 10).
MAX_UPLOAD_SIZE_MB="10"

AUTH_SECRET="your-secret-key-change-in-production"

APP_BASE_URL="http://localhost:3001"

# LLM API (optional, for AI-assisted document extraction)
# OpenAI-compatible endpoint (Ollama /v1, llama.cpp, vLLM, etc.)
LLM_API_URL="http://localhost:11434/v1"
LLM_API_KEY=""
LLM_MODEL="phi3:mini"
LLM_EMBEDDING_MODEL=""

# PDF API (docling-powered; optional, enhances AI extraction with better document parsing)
# PDF_API_URL="http://localhost:8100"

# DOCX API (optional, powers DOCX structural redline in submission diff)
# DOCX_API_URL="http://localhost:8101"

# Planner API (optional, enables auto session clustering)
# PLANNER_API_URL="http://localhost:8110"

# Dev render profiling (optional, dev-only): set to "true" to stream react-scan
# render/commit events to /api/react-scan-ingest -> dev-docs/react-scan/*.jsonl.
# Off by default to avoid per-commit overhead. Requires a full dev-server restart.
# VITE_REACT_SCAN="true"

# Web Push (VAPID) for favourite-presentation reminders (optional).
# Generate a keypair once: pnpm dlx web-push generate-vapid-keys
# The public key is defined once (VITE_-prefixed so the browser can read it;
# the server reads the same var). Only the private key is server-only.
# VITE_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:contact@your-conference.org"

# Docker image registry (used by build:docker / docker-bake.hcl)
REGISTRY="registry.example.com"

# Log level: a consola name (silent, error, warn, log, info, debug, trace) or
# its number. Defaults to info.
# LOG_LEVEL="info"
