# Database
DATABASE_URL="postgresql://suberus:suberus_dev_password@localhost:5432/suberus?schema=public"

# Garage S3 Storage
GARAGE_ENDPOINT="http://localhost:3902"
GARAGE_ACCESS_KEY_ID="your_access_key"
GARAGE_SECRET_ACCESS_KEY="your_secret_key"
GARAGE_BUCKET="suberus-files"

# Email (Mailpit for development)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@suberus.local"
MAILPIT_URL="http://localhost:8025"

# Auth
AUTH_SECRET="your-secret-key-change-in-production"

# App
APP_BASE_URL="http://localhost:3001"

# LLM API (optional, for AI-assisted document extraction)
# OpenAI-compatible endpoint (Ollama /v1, llama.cpp, vLLM, etc.)
LLM_API_URL="http://localhost:11434/v1"
LLM_API_KEY=""
LLM_MODEL="phi3:mini"
LLM_EMBEDDING_MODEL=""

# Docling API (optional, enhances AI extraction with better document parsing)
# DOCLING_URL="http://localhost:8100"

# Planner API (optional, enables auto session clustering)
# PLANNER_API_URL="http://localhost:8110"

# Dev render profiling (optional, dev-only): set to "true" to stream react-scan
# render/commit events to /api/react-scan-ingest -> dev-docs/react-scan/*.jsonl.
# Off by default to avoid per-commit overhead. Requires a full dev-server restart.
# VITE_REACT_SCAN="true"
