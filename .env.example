GARAGE_REGION="garage"

# Email (Mailpit for development)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@suberus.local"
SMTP_FROM_NAME="Suberus Conference"
