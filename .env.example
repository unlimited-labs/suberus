# Database
DATABASE_URL="postgresql://suberus:suberus_dev_password@localhost:5432/suberus?schema=public"

# Electric SQL
ELECTRIC_URL="http://localhost:3000"

# Garage S3 Storage
GARAGE_ENDPOINT="http://localhost:3902"
GARAGE_ACCESS_KEY_ID="your_access_key"
GARAGE_SECRET_ACCESS_KEY="your_secret_key"
GARAGE_BUCKET="suberus-files"
GARAGE_REGION="garage"

# Email (Mailpit for development)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@suberus.local"
SMTP_FROM_NAME="Suberus Conference"

# Auth
AUTH_SECRET="your-secret-key-change-in-production"
AUTH_URL="http://localhost:3001"

# App
NODE_ENV="development"
PORT="3001"

# Cron jobs (secure token for external cron triggers)
CRON_SECRET="your-secure-cron-secret"
