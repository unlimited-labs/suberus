{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}",
    "src/start.ts", // TanStack Start
    "src/server/plugins/**/*.ts", // nitro plugins
    "src/server/tasks/**/*.ts", // nitro tasks
    "src/shared/ui/**/*.{ts,tsx}",
    "src/integrations/**/*.{ts,tsx}",
    "src/features/dashboard/index.ts",
    "src/features/extraction/index.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignorePatterns": [
    ".agents/**",
    "docs/**",
    "scripts/repl.ts",
    "public/**",
    "poc/**"
  ],
  // Known-good deps not TS imports
  "ignoreDependencies": ["tw-animate-css", "shadcn"],
  "duplicates": {
    // 3+ occurrences; lower to 2 to report every duplicate pair.
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn",
    "boundary-violation": "error"
  },
  // CRAP here is inflated by estimated zero coverage; both paths are e2e-covered (bulk-email.spec.ts) and CC is trivial.
  "health": {
    "thresholdOverrides": [
      {
        "files": ["src/features/bulk-email/components/attachment-dropzone.tsx"],
        "functions": ["AttachmentDropzone"],
        "maxCrap": 45,
        "reason": "e2e-covered (attach/remove specs); CC 6, CRAP estimated-coverage artifact"
      },
      {
        "files": ["src/features/bulk-email/server/bulk-email.ts"],
        "functions": ["sendCampaignTest"],
        "maxCrap": 31,
        "reason": "e2e-covered (send-test spec); CC 5, CRAP estimated-coverage artifact"
      },
      // public-program theming components: CRAP inflated by estimated 0% coverage
      // (e2e-covered via public-program.spec.ts / presentation-favorites.spec.ts, not unit).
      {
        "files": [
          "src/features/planner/components/public-program/program-primitives.tsx"
        ],
        "functions": ["PresentationRow"],
        "maxCrap": 133,
        "reason": "e2e-covered (public-program.spec.ts presentations + author-info; presentation-favorites.spec.ts open/favorite); CC 10 after RowAuthors extraction, numbered/plain variant + interaction branches, estimated-coverage artifact"
      },
      {
        "files": [
          "src/features/planner/components/public-program/program-primitives.tsx"
        ],
        "functions": ["SessionHeader"],
        "maxCrap": 91,
        "reason": "e2e-covered (public-program.spec.ts, all 3 themes); CC 9 from optional dot/room/chair rendering, estimated-coverage artifact"
      },
      {
        "files": [
          "src/features/planner/components/public-program/layouts/list-body.tsx"
        ],
        "functions": ["TimeSlot", "BreakCard"],
        "maxCrap": 57,
        "reason": "e2e-covered (public-program.spec.ts); CC 5-7 from framed/minimal slot rendering, estimated-coverage artifact"
      },
      {
        "files": [
          "src/features/planner/components/public-program/program-shell.tsx"
        ],
        "functions": [
          "ProgramShell",
          "SearchBox",
          "ProgramStickyBar",
          "FramedHeader"
        ],
        "maxCrap": 57,
        "reason": "e2e-covered (public-program.spec.ts, all 3 themes); CC 5-7 from chrome/layout variant rendering, estimated-coverage artifact"
      },
      {
        "files": [
          "src/features/planner/components/public-program/presentation-preview-dialog.tsx"
        ],
        "maxCrap": 75,
        "reason": "e2e-covered (public-program.spec.ts author-info talk/author view switch; presentation-favorites.spec.ts favorite toggle; camera-ready.spec.ts download); CC 5-8 favorite/author-view/card branching, estimated-coverage artifact"
      },
      {
        "files": [
          "src/features/planner/components/public-program/program-interaction.tsx"
        ],
        "functions": ["ProgramInteractionProvider"],
        "maxCrap": 75,
        "reason": "e2e-covered (every public-program interaction spec routes through the provider); CC 8 provider glue null-coalescing + auth-gated author info, estimated-coverage artifact"
      },
      {
        "files": ["src/features/planner/server/favorites.ts"],
        "maxCrap": 60,
        "reason": "e2e-covered (public-program.spec.ts author-info signed-in/anonymous/off paths; presentation-favorites.spec.ts); CC 5-7 visibility guards + optional-chain/ternary field mapping, estimated-coverage artifact"
      },
      // camera-ready upload/serve: CRAP inflated by estimated 0% coverage; matchers unit-tested, paths e2e-covered (camera-ready.spec.ts).
      {
        "files": ["src/features/submissions/server/camera-ready.ts"],
        "functions": ["setCameraReady", "uploadCameraReadyBulkZip"],
        "maxCrap": 75,
        "reason": "setCameraReady e2e-covered (camera-ready.spec.ts per-submission upload); bulk matchers unit-tested (camera-ready-match.test.ts), orchestration is a linear guard-continue loop; estimated-coverage artifact"
      },
      {
        "files": ["src/routes/api/program/camera-ready.$slotId.ts"],
        "functions": ["GET"],
        "maxCrap": 31,
        "reason": "e2e-covered (camera-ready.spec.ts fetches the public URL → 200/application/pdf); CC 5 guard-clause route handler, estimated-coverage artifact"
      },
      // Finances: presentational logic unit-tested (calc/money-cells/due-cell/expense-toolbar/formula-input); the board form + server + export are e2e-covered (finances.spec.ts, 18 cases), CRAP inflated by estimated 0% unit coverage.
      {
        "files": ["src/features/finances/components/admin/finances-board.tsx"],
        "maxCrap": 160,
        "reason": "e2e-covered board form (finances.spec.ts, 18 cases); render-prop closures over TanStack form, pure logic extracted to calc.ts (unit-tested); estimated-coverage artifact"
      },
      {
        "files": ["src/features/finances/server/finances.ts"],
        "maxCrap": 60,
        "reason": "e2e-covered via the finances board; getFeeSummary/saveFinanceEntries orchestration, estimated-coverage artifact"
      },
      {
        "files": ["src/features/finances/components/admin/fee-projection.tsx"],
        "maxCrap": 45,
        "reason": "e2e-covered (finances.spec.ts simulation case); estimated-coverage artifact"
      },
      {
        "files": [
          "src/features/finances/components/admin/finances-settings-tab.tsx"
        ],
        "maxCrap": 35,
        "reason": "e2e-covered (finances-enabled.spec.ts VAT-rate management); estimated-coverage artifact"
      },
      {
        "files": ["src/routes/api/admin/finances/export.ts"],
        "maxCrap": 45,
        "reason": "XLSX export row builder; e2e asserts the endpoint, estimated-coverage artifact"
      }
    ]
  },
  // Feature-first vertical slices. Each feature is its own zone, so a sibling app-feature import fails.
  // `shared` is the floor (imports nothing above it);
  // `routes` compose anything;
  "boundaries": {
    "zones": [
      { "name": "routes", "patterns": ["src/routes/**"] },
      { "name": "shared", "patterns": ["src/shared/**"] },
      { "name": "workflow", "patterns": ["src/features/workflow/**"] },
      { "name": "settings", "patterns": ["src/features/settings/**"] },
      { "name": "activity-log", "patterns": ["src/features/activity-log/**"] },
      { "name": "auth", "patterns": ["src/features/auth/**"] },
      { "name": "survey", "patterns": ["src/features/survey/**"] },
      { "name": "extraction", "patterns": ["src/features/extraction/**"] },
      { "name": "reviews", "patterns": ["src/features/reviews/**"] },
      { "name": "exhibitors", "patterns": ["src/features/exhibitors/**"] },
      { "name": "submissions", "patterns": ["src/features/submissions/**"] },
      { "name": "planner", "patterns": ["src/features/planner/**"] },
      { "name": "fee", "patterns": ["src/features/fee/**"] },
      { "name": "profile", "patterns": ["src/features/profile/**"] },
      { "name": "users", "patterns": ["src/features/users/**"] },
      { "name": "invitations", "patterns": ["src/features/invitations/**"] },
      { "name": "dashboard", "patterns": ["src/features/dashboard/**"] },
      { "name": "tracks", "patterns": ["src/features/tracks/**"] },
      {
        "name": "email-templates",
        "patterns": ["src/features/email-templates/**"]
      },
      { "name": "install", "patterns": ["src/features/install/**"] },
      {
        "name": "submission-diff",
        "patterns": ["src/features/submission-diff/**"]
      },
      { "name": "finances", "patterns": ["src/features/finances/**"] }
    ],
    "rules": [
      { "from": "shared", "allow": [] },
      {
        "from": "routes",
        "allow": [
          "shared",
          "workflow",
          "settings",
          "activity-log",
          "auth",
          "survey",
          "submissions",
          "reviews",
          "planner",
          "extraction",
          "exhibitors",
          "fee",
          "profile",
          "users",
          "invitations",
          "dashboard",
          "tracks",
          "email-templates",
          "install",
          "submission-diff",
          "finances"
        ]
      },
      {
        "from": "workflow",
        "allow": ["shared", "settings", "activity-log", "auth"]
      },
      {
        "from": "settings",
        "allow": ["shared", "extraction", "exhibitors", "auth"]
      },
      { "from": "activity-log", "allow": ["shared"] },
      { "from": "auth", "allow": ["shared", "settings", "activity-log"] },
      { "from": "survey", "allow": ["shared", "settings", "auth"] },
      { "from": "extraction", "allow": ["shared", "settings", "auth"] },
      {
        "from": "reviews",
        "allow": ["shared", "workflow", "settings", "activity-log", "auth"]
      },
      {
        "from": "exhibitors",
        "allow": ["shared", "activity-log", "settings", "workflow", "auth"]
      },
      {
        "from": "submissions",
        "allow": [
          "shared",
          "workflow",
          "settings",
          "activity-log",
          "auth",
          "extraction",
          "reviews",
          "submission-diff"
        ]
      },
      { "from": "planner", "allow": ["shared", "settings", "auth"] },
      { "from": "fee", "allow": ["shared", "settings", "auth"] },
      {
        "from": "profile",
        "allow": ["shared", "settings", "activity-log", "auth", "survey"]
      },
      {
        "from": "users",
        "allow": ["shared", "activity-log", "survey", "settings", "auth"]
      },
      {
        "from": "invitations",
        "allow": ["shared", "activity-log", "settings", "auth"]
      },
      {
        "from": "dashboard",
        "allow": ["shared", "settings", "activity-log", "auth"]
      },
      { "from": "tracks", "allow": ["shared", "auth", "reviews"] },
      { "from": "email-templates", "allow": ["shared", "settings", "auth"] },
      { "from": "install", "allow": ["shared", "settings", "auth"] },
      { "from": "submission-diff", "allow": ["shared", "settings", "auth"] },
      { "from": "finances", "allow": ["shared", "settings", "auth"] }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [
        "src/*.ts",
        "src/*.tsx",
        "src/*.css",
        "src/server/**",
        "src/generated/**",
        "src/integrations/**",
        "src/routeTree.gen.ts",
        "*.ts",
        "*.mjs",
        "e2e/**",
        "docs/**",
        "scripts/**",
        "prisma/**"
      ]
    }
  }
}
