{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/routes/**/*.{tsx,ts}",
    "src/router.tsx",
    "src/styles.css",
    "src/jobs/*.ts",
    "e2e/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
  "ignore": [".agents/**", "src/components/ui/**"],
  "ignoreDependencies": ["@fontsource*", "tw-animate-css", "shadcn"],
  "ignoreBinaries": ["openssl"],
  "playwright": {
    "config": "playwright.config.ts",
    "entry": ["e2e/**/*.{spec,test}.ts", "e2e/setup/*.ts"]
  },
  "vitest": {
    "config": "vite.config.ts"
  }
}
