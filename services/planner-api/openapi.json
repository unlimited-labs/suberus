{
  "components": {
    "schemas": {
      "Cluster": {
        "properties": {
          "member_ids": {
            "items": {
              "type": "string"
            },
            "title": "Member Ids",
            "type": "array"
          },
          "session_index": {
            "title": "Session Index",
            "type": "integer"
          }
        },
        "required": [
          "session_index",
          "member_ids"
        ],
        "title": "Cluster",
        "type": "object"
      },
      "ClusterRequest": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "session_count": {
            "minimum": 1.0,
            "title": "Session Count",
            "type": "integer"
          },
          "tolerance": {
            "default": 1,
            "minimum": 0.0,
            "title": "Tolerance",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "session_count"
        ],
        "title": "ClusterRequest",
        "type": "object"
      },
      "ClusterResponse": {
        "properties": {
          "clusters": {
            "items": {
              "$ref": "#/components/schemas/Cluster"
            },
            "title": "Clusters",
            "type": "array"
          },
          "size_max": {
            "title": "Size Max",
            "type": "integer"
          },
          "size_min": {
            "title": "Size Min",
            "type": "integer"
          },
          "target_per_session": {
            "title": "Target Per Session",
            "type": "integer"
          }
        },
        "required": [
          "clusters",
          "target_per_session",
          "size_min",
          "size_max"
        ],
        "title": "ClusterResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "queue": {
            "additionalProperties": true,
            "title": "Queue",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "queue"
        ],
        "title": "Health",
        "type": "object"
      },
      "Item": {
        "properties": {
          "embedding": {
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "title": "Embedding",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "embedding"
        ],
        "title": "Item",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Suberus Planner API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "health__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/cluster": {
      "post": {
        "operationId": "cluster_v1_cluster_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClusterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cluster"
      }
    }
  }
}
