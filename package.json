{
  "name": "suberus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:docker": "dotenv run -q -- tsx scripts/docker.ts",
    "preview": "node --env-file=.env .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "unbuffer pnpm test:e2e --reporter=line 2>&1 | tee /tmp/e2e-live.log",
    "test:e2e:ui": "playwright test --ui",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "prepare": "lefthook install || true",
    "db:generate": "dotenv run -q -- prisma generate",
    "db:push": "dotenv run -q -- prisma db push",
    "db:migrate": "dotenv run -q -- prisma migrate dev --create-only --name",
    "db:update": "dotenv run -q -- prisma migrate deploy && prisma generate",
    "db:studio": "dotenv run -q -- prisma studio",
    "db:reset": "dotenv run -q -- prisma migrate reset --force",
    "repl": "dotenv run -q -- tsx scripts/repl.ts",
    "seed:diff-demo": "dotenv run -q -- tsx scripts/seed-diff-demo.ts",
    "vapid:generate": "tsx scripts/generate-vapid-keys.ts",
    "rand": "openssl rand -base64 32",
    "doctor": "npx react-doctor@latest",
    "sloppiness": "tsx scripts/sloppiness.ts"
  },
