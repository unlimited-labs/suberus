{
  "name": "suberus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:docker": "dotenv -e .env -- tsx scripts/docker.ts",
    "preview": "node --env-file=.env .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "unbuffer pnpm test:e2e --reporter=line 2>&1 | tee /tmp/e2e-live.log",
    "test:e2e:ui": "playwright test --ui",
    "format": "biome format",
    "lint": "biome lint --fix",
    "report-deprecated": "node report-deprecated.mjs",
    "prepare": "lefthook install || true",
    "db:generate": "dotenv -e .env -- prisma generate",
    "db:push": "dotenv -e .env -- prisma db push",
    "db:migrate": "dotenv -e .env -- prisma migrate dev --create-only --name",
    "db:update": "dotenv -e .env -- prisma migrate deploy && prisma generate",
    "db:studio": "dotenv -e .env -- prisma studio",
    "db:reset": "dotenv -e .env -- prisma migrate reset --force",
    "repl": "dotenv -e .env -- tsx scripts/repl.ts",
    "seed:diff-demo": "dotenv -e .env -- tsx scripts/seed-diff-demo.ts",
    "vapid:generate": "tsx scripts/generate-vapid-keys.ts",
    "rand": "openssl rand -base64 32",
    "update:shadcn:win": "Get-ChildItem -Path src/components/ui/ -Filter *.tsx | ForEach-Object { $baseName = [System.IO.Path]::GetFileNameWithoutExtension($_.Name); pnpx shadcn@latest add -y -o $baseName; }",
    "doctor": "npx react-doctor@latest"
  },
