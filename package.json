{
  "name": "suberus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "biome format",
    "lint": "biome lint --fix",
    "type-check": "tsc --noEmit",
    "report-deprecated": "tsx report-deprecated.ts",
    "check": "biome check --write",
    "prepare": "lefthook install",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev --create-only --name",
    "db:update": "dotenv -e .env.local -- prisma migrate deploy && prisma generate",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "app:setup": "tsx init.ts",
    "db:seed-users": "dotenv -e .env.local -- tsx prisma/seed-test-users.ts",
    "rand": "openssl rand -base64 32",
    "update:shadcn:win": "Get-ChildItem -Path src/components/ui/ -Filter *.tsx | ForEach-Object { $baseName = [System.IO.Path]::GetFileNameWithoutExtension($_.Name); pnpx shadcn@latest add -y -o $baseName; }"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.987.0",
    "@aws-sdk/s3-request-presigner": "^3.987.0",
    "@clack/prompts": "^1.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/crimson-pro": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/rajdhani": "^5.2.7",
    "@fontsource/spectral": "^5.2.8",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tabler/icons-react": "^3.36.1",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.9.5",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.159.5",
    "@tanstack/react-router-devtools": "^1.159.5",
    "@tanstack/react-router-ssr-query": "^1.159.5",
    "@tanstack/react-start": "^1.159.5",
    "@tanstack/react-table": "^8.21.2",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "countries-list": "^3.2.2",
    "dotenv": "^17.2.4",
    "html-react-parser": "^5.2.17",
    "lucide-react": "^0.563.0",
    "maplibre-gl": "^5.18.0",
    "nitro": "3.0.1-alpha.2",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.6",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.3.6",
    "unified": "^11.0.5",
    "vibe-rules": "^0.3.91",
    "vite-tsconfig-paths": "^6.1.0",
    "world-atlas": "^2.0.2",
    "xlsx": "^0.18.5",
    "xstate": "^5.26.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@playwright/test": "^1.58.2",
    "@tanstack/devtools-vite": "^0.5.1",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.0",
    "@types/recharts": "^2.0.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^28.0.0",
    "lefthook": "^2.1.0",
    "mailpit-api": "^1.7.0",
    "prisma": "^7.3.0",
    "shadcn": "^3.8.4",
    "ts-morph": "^27.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "lefthook",
      "msw",
      "prisma"
    ]
  }
}
