    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/crimson-pro": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/rajdhani": "^5.2.7",
    "@fontsource/spectral": "^5.2.8",
    "@ilamy/calendar": "^1.6.2",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@supercharge/promise-pool": "^3.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tabler/icons-react": "^3.41.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-hotkeys": "^0.9.1",
