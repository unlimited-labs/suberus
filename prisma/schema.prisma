generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Affiliation {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @unique
  createdAt         DateTime           @default(now())
  submissionAuthors SubmissionAuthor[]
  users             User[]

  @@index([name])
  @@map("affiliations")
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  image                String?
  email                String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  title                String?
  firstName            String?
  lastName             String?
  orcid                String?
  address              String?
  country              String?
  needInvoice          Boolean               @default(false)
  role                 UserRole              @default(AUTHOR)
  emailVerified        Boolean               @default(false)
  isActive             Boolean               @default(true)
  allowLateSubmission  Boolean               @default(false)
  lastLoginAt          DateTime?
  tosAcceptedAt        DateTime?
  affiliationId        String?               @db.Uuid
  accounts             Account[]
  editorDecisions      EditorDecision[]
  fee                  Fee?
  uploadedFiles        File[]
  assignedReviews      ReviewAssignment[]    @relation("AssignedReviews")
  reviewAssignments    ReviewAssignment[]
  reviews              Review[]
  submissionAuthors    SubmissionAuthor[]
  activityTargets      ActivityLog[]         @relation("ActivityTarget")
  activityActions      ActivityLog[]         @relation("ActivityPerformer")
  submissions          Submission[]          @relation("SubmissionOwner")
  sessions             Session[]
  passkeys             Passkey[]
  programSessionChairs ProgramSessionChair[]
  presentationFavorites PresentationFavorite[]
  pushSubscriptions    PushSubscription[]
  supervisedTracks     ConferenceTrack[]     @relation("TrackSupervisor")
  surveyAnswers        SurveyAnswer[]
  createdInvitations   Invitation[]          @relation("InvitationCreator")
  usedInvitation       Invitation?           @relation("InvitationUser")
  exhibitor            Exhibitor?            @relation("ExhibitorUser")
  decidedExhibitors    Exhibitor[]           @relation("ExhibitorDecider")
  documents            GeneratedDocument[]   @relation("UserDocuments")
  affiliation          Affiliation?          @relation(fields: [affiliationId], references: [id])

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([emailVerified])
  @@map("users")
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model EmailTemplate {
  id                    String         @id @default(uuid()) @db.Uuid
  eventType             EmailEventType @unique
  subject               String
  body                  String
  isHtml                Boolean        @default(false)
  ccEmails              String[]
  bccEmails             String[]
  isEnabled             Boolean        @default(true)
  availablePlaceholders String[]
  description           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([eventType])
  @@index([isEnabled])
  @@map("email_templates")
}

model ConferenceTrack {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  supervisorId String?  @db.Uuid
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supervisor  User?        @relation("TrackSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@index([supervisorId])
  @@index([isActive])
  @@map("conference_tracks")
}

model Keyword {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique
  createdAt   DateTime            @default(now())
  submissions SubmissionKeyword[]

  @@index([name])
  @@map("keywords")
}

model Submission {
  id                String               @id @default(uuid()) @db.Uuid
  sequentialNumber  Int                  @unique @default(autoincrement())
  type              SubmissionType
  title             String
  content           String
  status            SubmissionStatus     @default(DRAFT)
  currentRound      Int                  @default(1)
  userId            String               @db.Uuid
  trackId           String?              @db.Uuid
  presenterId       String?              @db.Uuid
  currentVersionId  String?              @unique @db.Uuid
  cameraReadyFileId String?              @unique @db.Uuid
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  editorDecisions   EditorDecision[]
  reviewAssignments ReviewAssignment[]
  reviews           Review[]
  authors           SubmissionAuthor[]   @relation("SubmissionAuthors")
  presentationSlot  PresentationSlot?
  embedding         SubmissionEmbedding?
  keywords          SubmissionKeyword[]
  activityLog       ActivityLog[]
  versions          SubmissionVersion[]  @relation("SubmissionVersions")
  currentVersion    SubmissionVersion?   @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  cameraReadyFile   File?                @relation("CameraReady", fields: [cameraReadyFileId], references: [id])
  presenterAuthor   SubmissionAuthor?    @relation("PresenterAuthor", fields: [presenterId], references: [id])
  track             ConferenceTrack?     @relation(fields: [trackId], references: [id])
  user              User                 @relation("SubmissionOwner", fields: [userId], references: [id])
  exhibitor         Exhibitor?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([trackId])
  @@index([presenterId])
  @@index([currentVersionId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, type, createdAt])
  @@index([status, userId, createdAt])
  @@map("submissions")
}

model SubmissionEmbedding {
  submissionId String                      @id @db.Uuid
  embedding    Unsupported("vector(2560)")
  hash         String
  model        String
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([hash])
  @@map("submission_embeddings")
}

model SubmissionVersion {
  id                   String      @id @default(uuid()) @db.Uuid
  submissionId         String      @db.Uuid
  version              Int         @default(1)
  title                String
  content              String
  comment              String?
  createdAt            DateTime    @default(now())
  fileId               String?     @db.Uuid
  reviews              Review[]
  file                 File?       @relation(fields: [fileId], references: [id])
  submission           Submission  @relation("SubmissionVersions", fields: [submissionId], references: [id], onDelete: Cascade)
  currentForSubmission Submission? @relation("CurrentVersion")
  authorsSnapshot      SubmissionVersionAuthor[]
  keywordsSnapshot     SubmissionVersionKeyword[]

  @@unique([submissionId, version])
  @@index([submissionId])
  @@map("submission_versions")
}

/// Frozen, per-version snapshot of the author composition (skład autorski) as it
/// was at the time the version was created. History/diff only — never mutated.
/// Affiliation and presenter are denormalized so renames/repointing don't rewrite
/// history. Current/canonical authors stay on SubmissionAuthor.
model SubmissionVersionAuthor {
  id          String            @id @default(uuid()) @db.Uuid
  versionId   String            @db.Uuid
  firstName   String
  lastName    String
  email       String
  affiliation String
  orderIndex  Int               @default(0)
  isPresenter Boolean           @default(false)
  createdAt   DateTime          @default(now())
  version     SubmissionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("submission_version_authors")
}

/// Frozen, per-version snapshot of the keyword/tag set. History/diff only.
model SubmissionVersionKeyword {
  id        String            @id @default(uuid()) @db.Uuid
  versionId String            @db.Uuid
  name      String
  createdAt DateTime          @default(now())
  version   SubmissionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, name])
  @@index([versionId])
  @@map("submission_version_keywords")
}

model SubmissionAuthor {
  id                      String       @id @default(uuid()) @db.Uuid
  submissionId            String       @db.Uuid
  userId                  String?      @db.Uuid
  firstName               String
  lastName                String
  email                   String
  orderIndex              Int          @default(0)
  isPresenter             Boolean      @default(false)
  createdAt               DateTime     @default(now())
  affiliationId           String?      @db.Uuid
  affiliation             Affiliation? @relation(fields: [affiliationId], references: [id])
  submission              Submission   @relation("SubmissionAuthors", fields: [submissionId], references: [id], onDelete: Cascade)
  user                    User?        @relation(fields: [userId], references: [id])
  presenterForSubmissions Submission[] @relation("PresenterAuthor")

  @@index([submissionId])
  @@index([userId])
  @@index([email])
  @@index([submissionId, orderIndex])
  @@map("submission_authors")
}

model SubmissionKeyword {
  id           String     @id @default(uuid()) @db.Uuid
  submissionId String     @db.Uuid
  keywordId    String     @db.Uuid
  createdAt    DateTime   @default(now())
  keyword      Keyword    @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, keywordId])
  @@index([submissionId])
  @@index([keywordId])
  @@map("submission_keywords")
}

model ReviewAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  submissionId   String           @db.Uuid
  reviewerId     String           @db.Uuid
  round          Int              @default(1)
  status         AssignmentStatus @default(PENDING)
  assignedAt     DateTime         @default(now())
  deadline       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  assignedBy     String?          @db.Uuid
  orderIndex     Int              @default(0)
  role           String?
  assignedByUser User?            @relation("AssignedReviews", fields: [assignedBy], references: [id])
  reviewer       User             @relation(fields: [reviewerId], references: [id])
  submission     Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  review         Review?

  @@unique([submissionId, reviewerId, round])
  @@index([submissionId, round, status])
  @@index([reviewerId, status])
  @@index([status, deadline])
  @@index([submissionId, round])
  @@map("review_assignments")
}

model Review {
  id              String             @id @default(uuid()) @db.Uuid
  assignmentId    String             @unique @db.Uuid
  submissionId    String             @db.Uuid
  reviewerId      String             @db.Uuid
  versionId       String?            @db.Uuid
  round           Int
  decision        ReviewDecision
  comments        String?
  privateNotes    String?
  scores          Json?
  confidenceLevel Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  assignment      ReviewAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewer        User               @relation(fields: [reviewerId], references: [id])
  submission      Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version         SubmissionVersion? @relation(fields: [versionId], references: [id])

  @@index([submissionId, round])
  @@index([reviewerId])
  @@index([assignmentId])
  @@map("reviews")
}

model EditorDecision {
  id             String             @id @default(uuid()) @db.Uuid
  submissionId   String             @db.Uuid
  editorId       String             @db.Uuid
  round          Int
  decision       EditorDecisionType
  reasoning      String?
  letterToAuthor String?
  basedOnReviews String[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  editor         User               @relation(fields: [editorId], references: [id])
  submission     Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, round])
  @@index([editorId])
  @@map("editor_decisions")
}

enum ActivityType {
  // User
  USER_REGISTERED
  USER_EMAIL_VERIFIED
  USER_PROFILE_UPDATED
  USER_PASSWORD_CHANGED
  USER_ROLE_CHANGED
  USER_TOGGLED_ACTIVE
  USER_TOGGLED_LATE_SUBMISSION
  USER_DELETED
  // Submission
  SUBMISSION_CREATED
  SUBMISSION_DRAFT_SUBMITTED
  SUBMISSION_STATUS_CHANGED
  SUBMISSION_WITHDRAWN
  SUBMISSION_RESUBMITTED
  SUBMISSION_REVISION_UPLOADED
  SUBMISSION_TRACK_CHANGED
  SUBMISSION_EDITED
  SUBMISSION_DELETED
  // Review
  REVIEW_ASSIGNED
  REVIEW_SUBMITTED
  REVIEW_CANCELLED
  REVIEW_OVERDUE
  // Decision
  DECISION_SUBMITTED
  DECISION_DESK_REJECT
  DECISION_DESK_ACCEPT
  DECISION_OVERRIDE
  // Invitation
  INVITATION_CREATED
  INVITATION_USED
  INVITATION_CANCELLED
  // Admin
  FEE_MARKED_PAID
  FEE_MARKED_UNPAID
  // Exhibitor
  EXHIBITOR_APPLIED
  EXHIBITOR_APPROVED
  EXHIBITOR_REJECTED
  EXHIBITOR_WITHDRAWN
  // Document
  DOCUMENT_GENERATED
  DOCUMENT_DELETED
}

model ActivityLog {
  id           String       @id @default(uuid()) @db.Uuid
  type         ActivityType
  userId       String?      @db.Uuid
  submissionId String?      @db.Uuid
  performedBy  String?      @db.Uuid
  detail       Json?
  createdAt    DateTime     @default(now())

  user       User?       @relation("ActivityTarget", fields: [userId], references: [id])
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  performer  User?       @relation("ActivityPerformer", fields: [performedBy], references: [id])

  @@index([createdAt])
  @@index([type])
  @@index([submissionId, createdAt])
  @@map("activity_log")
}

model Fee {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  paid      Boolean   @default(false)
  type      String    @default("Full")
  amount    Decimal?  @db.Decimal(10, 2)
  currency  String?   @default("EUR")
  paidAt    DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([paid])
  @@map("fees")
}

enum FinanceEntryKind {
  INCOME
  EXPENSE
}

model FinanceEntry {
  id            String           @id @default(uuid()) @db.Uuid
  kind          FinanceEntryKind
  label         String
  amount        Decimal          @db.Decimal(10, 2)
  amountExpr    String?
  contractor    String?
  vatRate       Int?
  amountIsGross Boolean          @default(true)
  dueDate       DateTime?
  paid          Boolean          @default(false)
  ordered       Boolean          @default(false)
  note          String?
  date          DateTime?
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([kind, sortOrder])
  @@map("finance_entries")
}

model File {
  id                 String              @id @default(uuid()) @db.Uuid
  entityType         FileEntityType
  entityId           String              @db.Uuid
  type               FileType
  storageKey         String              @unique
  fileName           String
  originalName       String
  mimeType           String
  size               Int
  uploadedById       String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  // sha256 of the stored bytes; content-addressing + "file unchanged" detection
  // for the version-diff pipeline. Nullable: backfilled lazily on first access.
  sha256             String?             @db.Char(64)
  uploadedBy         User?               @relation(fields: [uploadedById], references: [id])
  submissionVersions SubmissionVersion[]
  cameraReadyFor     Submission?         @relation("CameraReady")

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([type])
  @@index([storageKey])
  @@index([entityType, entityId, createdAt])
  @@index([sha256])
  @@map("files")
}

/// Kind of source artifact normalized for diffing.
enum ArtifactKind {
  DOCX
  PDF
}

/// Immutable normalized-HTML artifact for one source file under one toolchain.
/// Content-addressed: the unique key is the full toolchain fingerprint
/// (sourceSha256 + kind + pandoc/normalizer/schema versions), so identical
/// source bytes under the same toolchain dedupe across versions/submissions.
/// NEVER regenerated on read; a toolchain bump produces a NEW row (the old one
/// is kept — immutable-forever). The HTML itself lives in S3-compatible storage at `htmlKey`,
/// never in a column (avoids a wide-column seq-scan cliff).
model SubmissionVersionArtifact {
  id                   String       @id @default(uuid()) @db.Uuid
  sourceSha256         String       @db.Char(64)
  kind                 ArtifactKind
  pandocVersion        String
  normalizerConfigHash String       @db.Char(64)
  schemaVersion        Int
  htmlKey              String
  /// CAS key of the per-style CSS derived from the DOCX's own styles.xml (Word-faithful
  /// rendering). Null for artifacts with no custom styles or pre-v4 normalizers.
  cssKey               String?
  /// CAS shas of the figures this artifact references (figure liveness for the reaper).
  figureShas           String[]
  warnings             String?
  createdAt            DateTime     @default(now())

  @@unique([sourceSha256, kind, pandocVersion, normalizerConfigHash, schemaVersion])
  @@index([sourceSha256, kind, createdAt(sort: Desc)])
  @@map("submission_version_artifacts")
}

/// Immutable redline between two normalized artifacts. Content-addressed by the
/// pair of artifact HTML shas PLUS the xmldiff engine version, so identical content
/// pairs dedupe regardless of which versions requested them, and a diff-engine bump
/// yields a new row instead of silently mutating a historical redline.
/// `oldVersionId`/`newVersionId` are the displayed pair (plain columns, no relation
/// — keeps SubmissionVersion decoupled).
model VersionDiffArtifact {
  id             String   @id @default(uuid()) @db.Uuid
  oldArtifactSha String   @db.Char(64)
  newArtifactSha String   @db.Char(64)
  diffVersion    String
  oldVersionId   String   @db.Uuid
  newVersionId   String   @db.Uuid
  redlineKey     String
  insCount       Int      @default(0)
  delCount       Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([oldArtifactSha, newArtifactSha, diffVersion])
  @@map("version_diff_artifacts")
}

/// Inventory of every content-addressed object in the `version-diff/` CAS prefix
/// (figures, normalized HTML, redlines). The reaper (`cas:reaper` task) computes
/// the live set from artifact/diff rows and deletes any CasObject not referenced
/// past a grace window — mark-and-sweep, so a missed write never leaks forever.
model CasObject {
  key       String   @id
  size      Int
  createdAt DateTime @default(now())

  @@map("cas_objects")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @db.Uuid
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("user_verifications")
}

model Passkey {
  id           String    @id @default(uuid()) @db.Uuid
  name         String?
  publicKey    String
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@map("passkey")
}

model SentReminder {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  reminderType  EmailEventType
  entityId      String         @db.Uuid
  reminderIndex Int            @default(0)
  sentAt        DateTime       @default(now())

  @@unique([userId, reminderType, entityId, reminderIndex])
  @@index([userId, reminderType])
  @@index([entityId])
  @@map("sent_reminders")
}

model SurveyQuestion {
  id              String             @id @default(uuid()) @db.Uuid
  label           String
  type            SurveyQuestionType @default(CHECKBOX)
  options         Json?
  allowOther      Boolean            @default(false)
  isRequired      Boolean            @default(false)
  orderIndex      Int                @default(0)
  isActive        Boolean            @default(true)
  showInUsersList Boolean            @default(false)
  fieldName       String?
  audience        SurveyAudience     @default(ALL)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  answers         SurveyAnswer[]

  @@index([isActive, orderIndex])
  @@map("survey_questions")
}

model SurveyAnswer {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  questionId String         @db.Uuid
  value      String         @default("")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("survey_answers")
}

model Invitation {
  id            String           @id @default(uuid()) @db.Uuid
  email         String
  role          UserRole
  token         String           @unique
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime
  createdById   String           @db.Uuid
  usedById      String?          @unique @db.Uuid
  usedAt        DateTime?
  roleAppliedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdBy     User             @relation("InvitationCreator", fields: [createdById], references: [id])
  usedBy        User?            @relation("InvitationUser", fields: [usedById], references: [id])

  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@map("invitations")
}

model Room {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  link        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programSessions ProgramSession[]
  breaks          ScheduleBreak[]

  @@map("rooms")
}

model ProgramTrack {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  color       String?
  series      String?
  seriesOrder Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programSessions ProgramSession[]

  @@index([series, seriesOrder])
  @@map("program_tracks")
}

model ProgramSession {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  trackId   String?  @db.Uuid
  roomId    String?  @db.Uuid
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  track         ProgramTrack?         @relation(fields: [trackId], references: [id], onDelete: SetNull)
  room          Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  chairs        ProgramSessionChair[]
  presentations PresentationSlot[]

  @@index([startAt])
  @@index([roomId, startAt])
  @@index([trackId])
  @@map("program_sessions")
}

model ProgramSessionChair {
  sessionId String @db.Uuid
  userId    String @db.Uuid

  session ProgramSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@index([userId])
  @@map("program_session_chairs")
}

model PresentationSlot {
  id           String   @id @default(uuid()) @db.Uuid
  sessionId    String   @db.Uuid
  submissionId String   @unique @db.Uuid
  order        Int
  durationMin  Int
  cancelled    Boolean  @default(false)
  createdAt    DateTime @default(now())

  session    ProgramSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submission Submission     @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  favorites  PresentationFavorite[]

  @@unique([sessionId, order])
  @@map("presentation_slots")
}

model PresentationFavorite {
  slotId     String    @db.Uuid
  userId     String    @db.Uuid
  remindedAt DateTime?

  slot PresentationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
