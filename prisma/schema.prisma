model EmailCampaign {
  id              String              @id @default(uuid()) @db.Uuid
  subject         String              @default("")
  format          EmailCampaignFormat @default(MARKDOWN)
  bodySource      String              @default("") @map("body_source")
  replyTo         String?             @map("reply_to")
  renderedHtml    String?             @map("rendered_html")
  status          EmailCampaignStatus @default(DRAFT)
  totalRecipients Int                 @default(0) @map("total_recipients")
  sentCount       Int                 @default(0) @map("sent_count")
  failedCount     Int                 @default(0) @map("failed_count")
  jobProgressId   String?             @map("job_progress_id") @db.Uuid
  createdById     String?             @map("created_by_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  sentAt          DateTime?           @map("sent_at")

  recipients EmailCampaignRecipient[]

  @@index([status])
  @@index([createdAt])
  @@map("email_campaign")
}

model EmailCampaignRecipient {
  id         String    @id @default(uuid()) @db.Uuid
  campaignId String    @map("campaign_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  email      String
  firstName  String?   @map("first_name")
  lastName   String?   @map("last_name")
  titles     String    @default("")
  status     String    @default("PENDING")
  error      String?
  sentAt     DateTime? @map("sent_at")

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId, status])
  @@map("email_campaign_recipient")
}

/// An admin-uploaded .docx template with `{placeholder}` tokens. The source docx
/// lives in object storage at `storageKey`; `placeholders` are the tags detected
/// (and validated against the registry) at upload time.
model DocumentTemplate {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  storageKey   String              @unique
  originalName String
  size         Int
  placeholders String[]
  createdById  String?             @db.Uuid
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  documents    GeneratedDocument[]
  batches      DocumentBatch[]

  @@index([createdAt])
  @@map("document_templates")
}

/// A document generated for one participant from a template. Rendered async by the
/// `document-generate` worker: PENDING until the PDF is produced and stored at
/// `storageKey`, then READY (or FAILED with `error`).
model GeneratedDocument {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  templateId    String?           @db.Uuid
  batchId       String?           @db.Uuid
  name          String
  status        DocumentStatus    @default(PENDING)
  storageKey    String?           @unique
  size          Int?
  signed        Boolean           @default(false)
  error         String?
  generatedById String?           @db.Uuid
  createdAt     DateTime          @default(now())
  user          User              @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  template      DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  batch         DocumentBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([batchId])
  @@index([status])
  @@index([createdAt])
  @@map("generated_documents")
}

/// One bulk-generation run. Progress is derived from its rows' statuses
/// (`groupBy status where batchId`); `total` is the row count enqueued at start.
model DocumentBatch {
  id          String              @id @default(uuid()) @db.Uuid
  name        String?
  templateId  String?             @db.Uuid
  total       Int
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now())
  template    DocumentTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  documents   GeneratedDocument[]

  @@index([createdAt])
  @@map("document_batches")
}

enum DocumentStatus {
  PENDING
  READY
  FAILED
}
