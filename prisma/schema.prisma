generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Affiliation {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @unique
  createdAt         DateTime           @default(now())
  submissionAuthors SubmissionAuthor[]
  users             User[]

  @@index([name])
  @@map("affiliations")
}

model User {
  id                   String                    @id @default(uuid()) @db.Uuid
  image                String?
  email                String                    @unique
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  title                String?
  firstName            String?
  lastName             String?
  orcid                String?
  address              String?
  country              String?
  role                 UserRole                  @default(AUTHOR)
  emailVerified        Boolean                   @default(false)
  isActive             Boolean                   @default(true)
  lastLoginAt          DateTime?
  tosAcceptedAt        DateTime?
  affiliationId        String?                   @db.Uuid
  accounts             Account[]
  editorDecisions      EditorDecision[]
  fee                  Fee?
  uploadedFiles        File[]
  assignedReviews      ReviewAssignment[]        @relation("AssignedReviews")
  reviewAssignments    ReviewAssignment[]
  reviews              Review[]
  submissionAuthors    SubmissionAuthor[]
  activityTargets   ActivityLog[] @relation("ActivityTarget")
  activityActions   ActivityLog[] @relation("ActivityPerformer")
  submissions          Submission[]              @relation("SubmissionOwner")
  sessions             Session[]
  supervisedTracks     ConferenceTrack[]         @relation("TrackSupervisor")
  surveyAnswers        SurveyAnswer[]
  createdInvitations   Invitation[]              @relation("InvitationCreator")
  usedInvitation       Invitation?               @relation("InvitationUser")
  affiliation          Affiliation?              @relation(fields: [affiliationId], references: [id])

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([emailVerified])
  @@map("users")
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("app_settings")
}

model EmailTemplate {
  id                    String         @id @default(uuid()) @db.Uuid
  eventType             EmailEventType @unique
  subject               String
  body                  String
  isHtml                Boolean        @default(false)
  ccEmails              String[]
  bccEmails             String[]
  isEnabled             Boolean        @default(true)
  availablePlaceholders String[]
  description           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([eventType])
  @@index([isEnabled])
  @@map("email_templates")
}

model ConferenceTrack {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  supervisorId String?      @db.Uuid
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  supervisor   User?        @relation("TrackSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  submissions  Submission[]

  @@index([supervisorId])
  @@index([isActive])
  @@map("conference_tracks")
}

model Keyword {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique
  createdAt   DateTime            @default(now())
  submissions SubmissionKeyword[]

  @@index([name])
  @@map("keywords")
}

model Submission {
  id                String                    @id @default(uuid()) @db.Uuid
  sequentialNumber  Int                       @unique @default(autoincrement())
  type              SubmissionType
  title             String
  content           String
  status            SubmissionStatus          @default(SUBMITTED)
  currentRound      Int                       @default(1)
  userId            String                    @db.Uuid
  trackId           String?                   @db.Uuid
  presenterId       String?                   @db.Uuid
  currentVersionId  String?                   @unique @db.Uuid
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  editorDecisions   EditorDecision[]
  reviewAssignments ReviewAssignment[]
  reviews           Review[]
  authors           SubmissionAuthor[]        @relation("SubmissionAuthors")
  keywords          SubmissionKeyword[]
  activityLog       ActivityLog[]
  versions          SubmissionVersion[]       @relation("SubmissionVersions")
  currentVersion    SubmissionVersion?        @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  presenterAuthor   SubmissionAuthor?         @relation("PresenterAuthor", fields: [presenterId], references: [id])
  track             ConferenceTrack?          @relation(fields: [trackId], references: [id])
  user              User                      @relation("SubmissionOwner", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([trackId])
  @@index([presenterId])
  @@index([currentVersionId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, type, createdAt])
  @@index([status, userId, createdAt])
  @@map("submissions")
}

model SubmissionVersion {
  id                   String      @id @default(uuid()) @db.Uuid
  submissionId         String      @db.Uuid
  version              Int         @default(1)
  title                String
  content              String
  comment              String?
  createdAt            DateTime    @default(now())
  fileId               String?     @db.Uuid
  reviews              Review[]
  file                 File?       @relation(fields: [fileId], references: [id])
  submission           Submission  @relation("SubmissionVersions", fields: [submissionId], references: [id], onDelete: Cascade)
  currentForSubmission Submission? @relation("CurrentVersion")

  @@unique([submissionId, version])
  @@index([submissionId])
  @@map("submission_versions")
}

model SubmissionAuthor {
  id                      String       @id @default(uuid()) @db.Uuid
  submissionId            String       @db.Uuid
  userId                  String?      @db.Uuid
  firstName               String
  lastName                String
  email                   String
  orderIndex              Int          @default(0)
  isPresenter             Boolean      @default(false)
  createdAt               DateTime     @default(now())
  affiliationId           String?      @db.Uuid
  affiliation             Affiliation? @relation(fields: [affiliationId], references: [id])
  submission              Submission   @relation("SubmissionAuthors", fields: [submissionId], references: [id], onDelete: Cascade)
  user                    User?        @relation(fields: [userId], references: [id])
  presenterForSubmissions Submission[] @relation("PresenterAuthor")

  @@index([submissionId])
  @@index([userId])
  @@index([email])
  @@index([submissionId, orderIndex])
  @@map("submission_authors")
}

model SubmissionKeyword {
  id           String     @id @default(uuid()) @db.Uuid
  submissionId String     @db.Uuid
  keywordId    String     @db.Uuid
  createdAt    DateTime   @default(now())
  keyword      Keyword    @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, keywordId])
  @@index([submissionId])
  @@index([keywordId])
  @@map("submission_keywords")
}

model ReviewAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  submissionId   String           @db.Uuid
  reviewerId     String           @db.Uuid
  round          Int              @default(1)
  status         AssignmentStatus @default(PENDING)
  assignedAt     DateTime         @default(now())
  deadline       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  assignedBy     String?          @db.Uuid
  orderIndex     Int              @default(0)
  role           String?
  assignedByUser User?            @relation("AssignedReviews", fields: [assignedBy], references: [id])
  reviewer       User             @relation(fields: [reviewerId], references: [id])
  submission     Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  review         Review?

  @@unique([submissionId, reviewerId, round])
  @@index([submissionId, round, status])
  @@index([reviewerId, status])
  @@index([status, deadline])
  @@index([submissionId, round])
  @@map("review_assignments")
}

model Review {
  id               String             @id @default(uuid()) @db.Uuid
  assignmentId     String             @unique @db.Uuid
  submissionId     String             @db.Uuid
  reviewerId       String             @db.Uuid
  versionId        String?            @db.Uuid
  round            Int
  decision         ReviewDecision
  comments         String?
  privateNotes     String?
  scores           Json?
  confidenceLevel  Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  assignment       ReviewAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewer         User               @relation(fields: [reviewerId], references: [id])
  submission       Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version          SubmissionVersion? @relation(fields: [versionId], references: [id])

  @@index([submissionId, round])
  @@index([reviewerId])
  @@index([assignmentId])
  @@map("reviews")
}

model EditorDecision {
  id             String             @id @default(uuid()) @db.Uuid
  submissionId   String             @db.Uuid
  editorId       String             @db.Uuid
  round          Int
  decision       EditorDecisionType
  reasoning      String?
  letterToAuthor String?
  basedOnReviews String[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  editor         User               @relation(fields: [editorId], references: [id])
  submission     Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, round])
  @@index([editorId])
  @@map("editor_decisions")
}

enum ActivityType {
  // User
  USER_REGISTERED
  USER_EMAIL_VERIFIED
  USER_PROFILE_UPDATED
  USER_PASSWORD_CHANGED
  USER_ROLE_CHANGED
  USER_TOGGLED_ACTIVE
  USER_DELETED
  // Submission
  SUBMISSION_CREATED
  SUBMISSION_DRAFT_SUBMITTED
  SUBMISSION_STATUS_CHANGED
  SUBMISSION_WITHDRAWN
  SUBMISSION_RESUBMITTED
  SUBMISSION_TRACK_CHANGED
  SUBMISSION_DELETED
  // Review
  REVIEW_ASSIGNED
  REVIEW_STARTED
  REVIEW_SUBMITTED
  REVIEW_CANCELLED
  REVIEW_OVERDUE
  // Decision
  DECISION_SUBMITTED
  DECISION_DESK_REJECT
  DECISION_OVERRIDE
  // Invitation
  INVITATION_CREATED
  INVITATION_USED
  INVITATION_CANCELLED
  // Admin
  FEE_MARKED_PAID
  FEE_MARKED_UNPAID
}

model ActivityLog {
  id           String       @id @default(uuid()) @db.Uuid
  type         ActivityType
  userId       String?      @db.Uuid
  submissionId String?      @db.Uuid
  performedBy  String?      @db.Uuid
  detail       Json?
  createdAt    DateTime     @default(now())

  user        User?       @relation("ActivityTarget", fields: [userId], references: [id])
  submission  Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  performer   User?       @relation("ActivityPerformer", fields: [performedBy], references: [id])

  @@index([createdAt])
  @@index([type])
  @@index([submissionId, createdAt])
  @@map("activity_log")
}

model Fee {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  paid      Boolean   @default(false)
  type      String    @default("Full")
  amount    Decimal?  @db.Decimal(10, 2)
  currency  String?   @default("EUR")
  paidAt    DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([paid])
  @@map("fees")
}

model File {
  id                 String              @id @default(uuid()) @db.Uuid
  entityType         FileEntityType
  entityId           String              @db.Uuid
  type               FileType
  storageKey         String              @unique
  fileName           String
  originalName       String
  mimeType           String
  size               Int
  uploadedById       String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  uploadedBy         User?               @relation(fields: [uploadedById], references: [id])
  submissionVersions SubmissionVersion[]

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([type])
  @@index([storageKey])
  @@index([entityType, entityId, createdAt])
  @@map("files")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @db.Uuid
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("user_verifications")
}

model SentReminder {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  reminderType  EmailEventType
  entityId      String         @db.Uuid
  reminderIndex Int            @default(0)
  sentAt        DateTime       @default(now())

  @@unique([userId, reminderType, entityId, reminderIndex])
  @@index([userId, reminderType])
  @@index([entityId])
  @@map("sent_reminders")
}

model SurveyQuestion {
  id         String             @id @default(uuid()) @db.Uuid
  label      String
  type       SurveyQuestionType @default(CHECKBOX)
  options    Json?
  isRequired Boolean            @default(false)
  orderIndex Int                @default(0)
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  answers    SurveyAnswer[]

  @@index([isActive, orderIndex])
  @@map("survey_questions")
}

model SurveyAnswer {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  questionId String         @db.Uuid
  value      String         @default("")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("survey_answers")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  email       String
  role        UserRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdById String           @db.Uuid
  usedById    String?          @unique @db.Uuid
  usedAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User             @relation("InvitationCreator", fields: [createdById], references: [id])
  usedBy      User?            @relation("InvitationUser", fields: [usedById], references: [id])

  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@map("invitations")
}

enum SurveyQuestionType {
  CHECKBOX
  TEXT
  SINGLE_SELECT
  MULTI_SELECT
}

enum InvitationStatus {
  PENDING
  USED
  EXPIRED
  CANCELLED
}

enum UserRole {
  AUTHOR
  REVIEWER
  EDITOR
  ADMIN
}

enum SubmissionType {
  ABSTRACT
  FULL_PAPER
  POSTER
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVIEWS_COMPLETE
  AWAITING_DECISION
  REVISE_REQUIRED
  RESUBMITTED
  ACCEPTED
  CONDITIONALLY_ACCEPTED
  REJECTED
  WITHDRAWN
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum ReviewDecision {
  ACCEPT
  ACCEPT_WITH_MINOR_REVISIONS
  REVISE_AND_RESUBMIT
  REJECT
}

enum EditorDecisionType {
  ACCEPT
  CONDITIONALLY_ACCEPT
  REVISE_AND_RESUBMIT
  REJECT
}

enum ReviewMode {
  OPEN
  SINGLE_BLIND
  DOUBLE_BLIND
}

enum FileType {
  SUBMISSION_MAIN
  SUBMISSION_SUPPLEMENTARY
  REVIEW_ATTACHMENT
  OTHER
}

enum FileEntityType {
  SUBMISSION
  SUBMISSION_VERSION
  REVIEW
}

enum EmailEventType {
  SUBMISSION_RECEIVED
  SUBMISSION_WITHDRAWN
  REVIEWER_ASSIGNED
  REVIEWER_REMINDER
  REVIEW_SUBMITTED
  ALL_REVIEWS_COMPLETE
  DECISION_ACCEPTED
  DECISION_CONDITIONALLY_ACCEPTED
  DECISION_REVISE_REQUIRED
  DECISION_REJECTED
  DECISION_OVERRIDDEN
  REVISION_REMINDER
  REVISION_RECEIVED
  DEADLINE_APPROACHING
  ACCOUNT_CREATED
  PASSWORD_RESET
  EMAIL_VERIFICATION
  INVITATION
}

