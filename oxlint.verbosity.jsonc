// Measure-only config for `pnpm sloppiness` — NEVER run with --fix.
// Rules here flag lines that say the same thing in more lines than needed.
// Rules already enforced in oxlint.config.ts (no-unneeded-ternary,
// no-useless-catch, ...) are omitted: --fix keeps them at zero anyway.
{
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "src/generated/**",
    "src/shared/ui/**",
  ],
  "rules": {
    "no-else-return": "warn",
    "no-lonely-if": "warn",
    "no-useless-return": "warn",
    "no-useless-concat": "warn",
    "prefer-object-spread": "warn",
    "typescript/no-inferrable-types": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn",
    "unicorn/no-useless-length-check": "warn",
    "unicorn/no-useless-promise-resolve-reject": "warn",
    "unicorn/no-useless-spread": "warn",
    "unicorn/no-useless-switch-case": "warn",
    "unicorn/no-useless-undefined": "warn",
    "unicorn/prefer-logical-operator-over-ternary": "warn",
  },
}
