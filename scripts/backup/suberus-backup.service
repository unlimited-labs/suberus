[Unit]
Description=Suberus backup (PostgreSQL + Garage S3 -> restic/SFTP)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# Adjust to where the repo is deployed on the VPS.
WorkingDirectory=/opt/suberus
ExecStart=/opt/suberus/scripts/backup/backup.sh
# Config is loaded from scripts/backup/backup.env by the script itself.
# Run as a user that can talk to the Docker socket.
User=root
TimeoutStartSec=3600
