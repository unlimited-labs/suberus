[Unit]
Description=Suberus restic repository integrity check [%i]
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/suberus
Environment=BACKUP_ENV=/opt/suberus/scripts/backup/backup.env.%i
ExecStart=/usr/bin/env bash -c 'source scripts/backup/lib.sh; load_config; restic_cmd check'
User=root
TimeoutStartSec=7200
