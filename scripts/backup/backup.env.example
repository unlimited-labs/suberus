# Suberus backup configuration. Copy to backup.env (git-ignored) and edit.
#   cp scripts/backup/backup.env.example scripts/backup/backup.env

# --- restic repository (off-site SFTP) -----------------------------------
export RESTIC_REPOSITORY="sftp:backup@backup-host:/srv/suberus-restic"
# Point this at a 0600 file you control. Root/systemd deploys use /etc;
# per-user (no-sudo, cron) deploys keep it next to the tooling, e.g.
# ~/suberus-backup/restic-password. Back up this password separately.
export RESTIC_PASSWORD_FILE="/etc/suberus/restic-password"
# Alternatively (less safe): export RESTIC_PASSWORD="..."

# Optional: use a specific SSH key/options for the SFTP backend without an
# OS-level ~/.ssh/config entry. Must end with: -s sftp
# RESTIC_SFTP_COMMAND="ssh kbzowski@host -i /path/to/key -o StrictHostKeyChecking=accept-new -s sftp"

# --- PostgreSQL (accessed via docker exec) -------------------------------
PG_CONTAINER="suberus-postgres"
PG_USER="suberus"
PG_DB="suberus"
DUMP_EXCLUDE_PGBOSS=1            # 1 = drop transient pgboss job-queue schema from the dump

# --- Garage / rclone -----------------------------------------------------
RCLONE_REMOTE="garage"
GARAGE_BUCKET="suberus-files"
S3_EXCLUDE="extraction-staging/**"   # temp pre-extraction files (never in the files table)

# Option A — static rclone config (single instance, S3 port reachable):
RCLONE_CONF="./garage/rclone.conf"

# Option B — resolve the Garage S3 endpoint from a container at runtime.
# Use this when the Garage S3 port is NOT published to the host (common on
# multi-tenant hosts). The container IP is looked up via `docker inspect` on
# every run, so it survives container restarts. Overrides RCLONE_CONF.
# GARAGE_CONTAINER="suberus-amf2026-garage"
# GARAGE_ACCESS_KEY_ID="..."
# GARAGE_SECRET_ACCESS_KEY="..."
# GARAGE_S3_PORT="3902"

# --- Retention (~4 weeks) ------------------------------------------------
KEEP_DAILY=7
KEEP_WEEKLY=4

# --- Misc ----------------------------------------------------------------
STAGING_DIR="/var/tmp/suberus-backup"
BACKUP_HOST_TAG="suberus-prod"   # restic --host tag
